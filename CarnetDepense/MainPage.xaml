<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CarnetDepenses.ViewModels"
             x:Class="CarnetDepense.MainPage"
             Title="Carnet de Dépenses">

    <Grid RowDefinitions="Auto, Auto, *"
          Padding="16" RowSpacing="10">
        <VerticalStackLayout Spacing="8">
            <Entry Placeholder="Libellé" Text="{Binding Libelle}" />
            <Entry Placeholder="Montant" Keyboard="Numeric"
                   Text="{Binding MontantTexte}" />
            <Button Text="Ajouter" Command="{Binding AjouterCommand}" />
        </VerticalStackLayout>

        <Label Grid.Row="1" FontSize="18" FontAttributes="Bold"
               Text="{Binding Total, StringFormat='Total : {0:N0} FCFA'}" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Depenses}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8">
                        <Label Text="{Binding Libelle}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Montant, StringFormat='{0:N0} FCFA'}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="2" Text="X"
                                CommandParameter="{Binding .}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DepensesViewModel}}, Path=SupprimerCommand}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
